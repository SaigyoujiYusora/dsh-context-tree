{
  "name": "dsh-context-tree",
  "version": "0.1.9",
  "type": "module",
  "description": "按楼层创建独立尝试、编辑分支并切换整棵上下文树",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib", "cordis.patch.yml", "README.md", "NOTICE.md", "LICENSES"],
  "repository": {"type": "git", "url": "git+https://github.com/SaigyoujiYusora/dsh-context-tree.git"},
  "engines": {"node": ">=24", "dsh": ">=0.2.1-0 <0.2.2-0"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-workspace"]},
    "compatibility": {"dshReleases": {"0.2.1-rc.2": "compatible", "0.2.1-rc.3": "compatible"}}
  },
  "scripts": {"build": "node scripts/build-client.mjs", "prepare": "npm run build", "test": "node --import ./test/host-loader.mjs --test test/*.test.mjs"},
  "peerDependencies": {"@deepseek-ai/dsh-session": ">=0.2.1-0 <0.2.2-0"},
  "peerDependenciesMeta": {"@deepseek-ai/dsh-session": {"optional": true}},
  "devDependencies": {"esbuild": "0.28.2"}
}
